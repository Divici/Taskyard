{
  "name": "taskyard",
  "productName": "Taskyard",
  "version": "0.1.0",
  "private": true,
  "description": "A Fences-style desktop organizer for Windows 11",
  "main": "./out/main/index.js",
  "author": "David Aihe",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "lint": "eslint --cache --max-warnings 0 .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:win": "playwright test",
    "verify:zorder": "tsx scripts/verify-zorder.ts",
    "verify:koffi": "tsx scripts/verify-koffi.ts",
    "dist": "electron-vite build && electron-builder --win nsis"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "electron-log": "^5.4.4",
    "koffi": "^3.3.1",
    "write-file-atomic": "^8.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "1.63",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "jsdom": "^30.1.1",
    "lucide-react": "^1.47.0",
    "playwright": "1.63",
    "prettier": "^3.7.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^3.2.7",
    "vitest-axe": "^0.1.0",
    "zustand": "^5.0.15"
  }
}
